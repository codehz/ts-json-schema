{
  "name": "@codehz/ts-json-schema",
  "version": "0.3.0",
  "description": "将 TypeScript 类型转换为 JSON Schema 的简单工具（基于 TypeScript Compiler API）",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "typescript",
    "json-schema",
    "typescript-compiler-api",
    "schema",
    "ts-json-schema"
  ],
  "scripts": {
    "typecheck": "bunx tsc --noEmit",
    "build": "bunx tsdown -c tsdown.config.ts",
    "prepack": "bun run build",
    "prepare": "bunx husky || exit 0",
    "test": "bun test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codehz/ts-json-schema.git"
  },
  "bugs": {
    "url": "https://github.com/codehz/ts-json-schema/issues"
  },
  "homepage": "https://github.com/codehz/ts-json-schema#readme",
  "author": "codehz",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native-preview": "npm:typescript@7.1.0-beta",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "mcp-bun": "^1.3.0",
    "oxlint": "^1.82.0",
    "prettier": "^3.7.4",
    "tsdown": "^0.17.2",
    "typescript": "7.1.0-beta"
  },
  "peerDependencies": {
    "typescript": "7.1.0-beta"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "lint-staged": {
    "*.{ts,js,json,md}": [
      "prettier --write"
    ],
    "*.{ts,js}": [
      "oxlint --fix"
    ]
  }
}
